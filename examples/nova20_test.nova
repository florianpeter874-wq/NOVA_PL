entryp Main main

program Main {

    function greet() {
        set str name = "NOVA";
        print("Hello, " + name);
    }
    function strret great(str name) {
        ret "Hello " + name;
    }

    function main() {
        set int x = 10;
        set int y = 3;

        greet();

        print(x + y);
        print(x - y);
        print(x * y);
        print(x / y);
        print(x % y);

        if (x > y && x != 0) {
            print("Math works!\n");
        } else {
            print("Something is wrong.");
        }

        set str a = "Hello";
        set str b = " World\n";

        print(a + b);

        while (x > 0) {
            print(x);

            set int next = x - 1;
            x = next;
        }

        print("NOVA test finished!\n");
        set int numbers[5];

        numbers[0] = 10;
        numbers[1] = 20;
        numbers[2] = 30;
        numbers[3] = 40;

        print(numbers[0]);
        print(numbers[1]);
        print(numbers[2]);
        print(numbers[3]);
        set str message = great("NOVA");
        print(message);
        set file f = file.open("test.txt");

        file.write(f, "Hello from NOVA!");

        set str content = file.read(f);

        print(content);

        file.close(f);
    }
}
